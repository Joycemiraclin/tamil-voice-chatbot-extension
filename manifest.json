{
  "manifest_version": 3,
  "name": "Zero Literacy Chatbot",
  "version": "1.0",
  "description": "Helps users understand government schemes in Tamil with voice support.",
  "permissions": ["activeTab", "scripting", "storage","tabs"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.gov.in/*", "*://*.tn.gov.in/*"], 
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "schemes.json",
        "tesseract.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ]
}
